# Pooled Neon URL (host contains "-pooler") — used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct Neon URL — used by Alembic migrations and scripts/.
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Telegram bot token: initData of every request is verified against it.
BOT_TOKEN=
# Max age of initData auth_date, seconds (default 86400).
INIT_DATA_MAX_AGE_SECONDS=86400

FOOTBALL_DATA_API_KEY=your_key_here

# Secret passed to Telegram setWebhook (secret_token); the webhook rejects requests without it.
# Allowed charset: A-Z a-z 0-9 _ - (1-256 chars), e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for /api/cron/tick; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. Generate: openssl rand -hex 32
CRON_SECRET=
